{# templates/form/fields.html.twig #}
{# Form theme assorti au style "glassmorphism néon" de l'appli de paie #}

{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div class="form-row{% if not valid %} form-row--error{% endif %}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
        {%- if help is not empty -%}
            <p class="form-help">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
        {%- endif -%}
    </div>
{%- endblock form_row -%}

{%- block form_label -%}
    {%- if label is not same as(false) -%}
        {%- if not compound -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label')|trim}) -%}
        {%- else -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label form-label--group')|trim}) -%}
        {%- endif -%}
        {%- if required -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label--required')|trim}) -%}
        {%- endif -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_widget_simple -%}
    {%- set type = type|default('text') -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-input')|trim}) -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-input form-input--textarea')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-input form-select')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{%- block money_widget -%}
    {%- set currency_symbol = money_pattern|form_encode_currency('')|trim -%}
    <div class="form-money">
        {{- block('form_widget_simple') -}}
        {%- if currency_symbol is not empty -%}
            <span class="form-money__currency">{{ currency_symbol }}</span>
        {%- endif -%}
    </div>
{%- endblock money_widget -%}

{%- block checkbox_row -%}
    <div class="form-row form-row--checkbox">
        <label class="form-checkbox">
            {{- form_widget(form) -}}
            <span class="form-checkbox__box"></span>
            <span class="form-checkbox__label">{{ label|trans(label_translation_parameters, translation_domain) }}</span>
        </label>
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-checkbox__input')|trim}) -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="form-errors">
            {%- for error in errors -%}
                <li class="form-errors__item">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block submit_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' btn-submit')|trim}) -%}
    {{- parent() -}}
{%- endblock submit_widget -%}

{%- block button_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' btn-secondary')|trim}) -%}
    {{- parent() -}}
{%- endblock button_widget -%}

{%- block form_start -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' app-form')|trim}) -%}
    {{- parent() -}}
{%- endblock form_start -%}
